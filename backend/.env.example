# ============================================================================
#  BACKEND ENVIRONMENT  —  Vercel project: api-hai-accounting
# ============================================================================
#  Local use:   cp .env.example .env    then fill in the values below
#  Vercel use:  Project → Settings → Environment Variables → paste key/value
#
#  NEVER commit the filled-in .env — only this template is tracked.
# ============================================================================


# ── REQUIRED ────────────────────────────────────────────────────────────────

# MongoDB Atlas → Connect → Drivers.
# Include the database name and URL-encode any special chars in the password.
MONGODB_URI=

# CORS allowlist. Requests from any other origin are rejected.
# Production: https://hai-accounting.vercel.app
# Local:      http://localhost:3000
CLIENT_URL=

NODE_ENV=production


# ── FIREBASE ADMIN (server-side token verification) ─────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
#
# Use EITHER option A (three vars) OR option B (one var). Option B is more
# reliable on Vercel because it avoids newline mangling in the private key.

# --- Option A: individual fields from the downloaded JSON ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key including the BEGIN/END lines. Literal \n sequences are
# normalised by config/firebase.ts, but a key broken by the paste fails with an
# unhelpful auth error — if that happens, switch to option B.
FIREBASE_PRIVATE_KEY=

# --- Option B: the whole service-account JSON, base64-encoded (RECOMMENDED) ---
#   macOS/Linux:  base64 -i service-account.json
#   Windows:      certutil -encode service-account.json out.txt
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=


# ── CLOUDINARY (file storage for documents & images) ────────────────────────
# Cloudinary dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── GOOGLE GEMINI (document OCR + chatbot) ──────────────────────────────────
# Google AI Studio → Get API key.
# Note: the free tier may allow your content to be used for product improvement.
# Check the current terms before sending client financial data through it.
GEMINI_API_KEY=


# ============================================================================
#  OPTIONAL — every one of these has a working default in code.
#  Uncomment only to override. Values shown are the defaults.
# ============================================================================


# ── DOCUMENT PROCESSING QUEUE ───────────────────────────────────────────────
# BullMQ needs Redis. WITHOUT THIS, UPLOADED DOCUMENTS ARE NEVER PROCESSED.
# Also note: Vercel functions terminate after each request, so the queue worker
# will not stay alive there. A long-running host is needed to consume the queue.
# REDIS_URL=

# DOCUMENTS_GEMINI_MODEL=gemini-3-flash-preview
# DOCUMENTS_GEMINI_MODEL_ADVANCED=
# DOCUMENTS_GEMINI_MODEL_BASIC=

# Files larger than this are rejected with a message pointing at CSV/Excel.
# DOCUMENTS_GEMINI_MAX_INLINE_BYTES=18874368

# Bank statements are read in page windows. Larger = fewer API calls but more
# risk of a truncated response.
# DOCUMENTS_STATEMENT_PAGES_PER_WINDOW=8
# DOCUMENTS_STATEMENT_MAX_PAGES=120

# Set to "false" to stop receipts auto-creating Expense records.
# DOCUMENTS_AUTO_CREATE_EXPENSE=true

# Set to "true" to bypass the AI extractor entirely.
# DOCUMENTS_DISABLE_GEMINI=false

# DOCUMENTS_SCAN_STALE_MINUTES=15
# DOCUMENTS_SCAN_CRON_ENABLED=
# DOCUMENTS_SCAN_CRON_INTERVAL_MS=


# ── EMAIL DOCUMENT INGESTION (forward receipts to a mailbox) ────────────────
# Only needed if you want documents to arrive by email.
# Change the domain to one you actually control.
# DOCUMENTS_MAILBOX_DOMAIN=inbox.myapp.com

# Shared secret for the POST /api/documents/email-ingest webhook.
# DOCUMENTS_INGEST_KEY=

# DOCUMENTS_EMAIL_IMAP_HOST=
# DOCUMENTS_EMAIL_IMAP_PORT=993
# DOCUMENTS_EMAIL_IMAP_SECURE=true
# DOCUMENTS_EMAIL_IMAP_USER=
# DOCUMENTS_EMAIL_IMAP_PASS=
# DOCUMENTS_EMAIL_POLLING_ENABLED=false
# DOCUMENTS_EMAIL_POLL_INTERVAL_MS=
# DOCUMENTS_EMAIL_ONLY_BANK_STATEMENTS=
# DOCUMENTS_EMAIL_MIN_ATTACHMENT_BYTES=


# ── CHATBOT / KNOWLEDGE BASE ────────────────────────────────────────────────
# The vector store runs on a SEPARATE mongoose connection. Falls back to
# MONGODB_URI + /chatbot_db when unset.
# CHATBOT_MONGODB_URI=
# CHATBOT_LLM_MODEL=
# CHATBOT_GEMINI_MODEL=
# CHATBOT_EMBEDDING_MODEL=
# CHATBOT_EMBEDDING_DIMENSIONS=768

# Only if using Groq instead of Gemini for chat.
# GROQ_API_KEY=


# ── SCHEDULERS ──────────────────────────────────────────────────────────────
# These use setInterval and will NOT run on Vercel serverless — the process is
# torn down between requests. Use Vercel Cron or a long-running host.
# RECURRING_BILL_INTERVAL_MS=
# RECURRING_EXPENSE_INTERVAL_MS=


# ── MISC ────────────────────────────────────────────────────────────────────
# Vercel assigns the port; leave unset in production.
# PORT=5000

# Requests per window. Defaults to 200 in production, 1000 otherwise.
# RATE_LIMIT_MAX=200
