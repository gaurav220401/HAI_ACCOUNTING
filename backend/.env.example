# Backend environment example
# Do not commit real secrets.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/hai_accounting

# Firebase Admin credentials (production/Vercel preferred)
# Priority 1: Individual fields (recommended)
# From service-account JSON:
#   project_id      -> FIREBASE_PROJECT_ID
#   client_email    -> FIREBASE_CLIENT_EMAIL
#   private_key     -> FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=hai-accounting
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@hai-accounting.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional metadata fields (not used by current backend code)
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_CLIENT_ID=...

# Priority 2: Base64 encoded JSON
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# Priority 3: Raw single-line JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Priority 4 (local dev fallback): path to JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Cloudinary storage (required for document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Documents module (no AWS required)
DOCUMENTS_INGEST_KEY=change_this_ingest_secret
DOCUMENTS_MAILBOX_DOMAIN=inbox.myapp.com
DOCUMENTS_EMAIL_POLLING_ENABLED=false
DOCUMENTS_EMAIL_POLL_INTERVAL_MS=60000
# Set true only when debugging IMAP protocol traffic
DOCUMENTS_EMAIL_IMAP_DEBUG=false
# Timeout for IMAP polling in milliseconds; prevent unhandled socket timeout crash.
DOCUMENTS_EMAIL_IMAP_TIMEOUT_MS=45000
# Optional connect/greeting timeout tuning for slower providers
DOCUMENTS_EMAIL_IMAP_CONNECT_TIMEOUT_MS=30000
DOCUMENTS_EMAIL_IMAP_GREETING_TIMEOUT_MS=20000
# Optional inbound IMAP overrides (when SMTP host/user differs from IMAP settings)
# DOCUMENTS_EMAIL_IMAP_HOST=imap.gmail.com
# DOCUMENTS_EMAIL_IMAP_PORT=993
# DOCUMENTS_EMAIL_IMAP_SECURE=true
# DOCUMENTS_EMAIL_IMAP_USER=your_imap_user
# DOCUMENTS_EMAIL_IMAP_PASS=your_imap_password
# Retry transient IMAP connection failures before applying poll backoff (1-3)
DOCUMENTS_EMAIL_IMAP_RETRY_ATTEMPTS=2
# Exponential backoff cap after transient IMAP failures
DOCUMENTS_EMAIL_POLL_FAILURE_BACKOFF_MAX_MS=900000
# Ignore tiny/inline email parts; only real attachments above this size are ingested
DOCUMENTS_EMAIL_MIN_ATTACHMENT_BYTES=2048
# If true, only bank-statement-like email attachments are ingested
DOCUMENTS_EMAIL_ONLY_BANK_STATEMENTS=true

# Gemini AI processing
GEMINI_API_KEY=your_gemini_api_key
DOCUMENTS_GEMINI_MODEL=gemini-3-flash-preview
DOCUMENTS_GEMINI_MODEL_BASIC=gemini-3-flash-preview
DOCUMENTS_GEMINI_MODEL_ADVANCED=gemini-3-flash-preview
DOCUMENTS_GEMINI_MAX_INLINE_BYTES=8388608
DOCUMENTS_DISABLE_GEMINI=false

# Centralized OCR system (uses Gemini AI)
# Override model specifically for OCR (falls back to DOCUMENTS_GEMINI_MODEL if unset)
# OCR_GEMINI_MODEL=gemini-2.0-flash
DOCUMENTS_SCAN_CRON_ENABLED=true
DOCUMENTS_SCAN_CRON_INTERVAL_MS=45000
DOCUMENTS_SCAN_STALE_MINUTES=10
DOCUMENTS_FOLDER_OPEN_ACCESS=true

# Optional: API rate limiting (default: 200 in production, 1000 in development)
# RATE_LIMIT_MAX=1000

# Optional queue acceleration (if omitted, processing runs inline)
# REDIS_URL=redis://localhost:6379
