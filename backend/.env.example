# Backend environment example
# Do not commit real secrets.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/hai_accounting

# Firebase Admin credentials (production/Vercel preferred)
# Priority 1: Individual fields (recommended)
# From service-account JSON:
#   project_id      -> FIREBASE_PROJECT_ID
#   client_email    -> FIREBASE_CLIENT_EMAIL
#   private_key     -> FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=hai-accounting
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@hai-accounting.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional metadata fields (not used by current backend code)
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_CLIENT_ID=...

# Priority 2: Base64 encoded JSON
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# Priority 3: Raw single-line JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Priority 4 (local dev fallback): path to JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Cloudinary storage (required for document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Documents module (no AWS required)
DOCUMENTS_INGEST_KEY=change_this_ingest_secret
DOCUMENTS_MAILBOX_DOMAIN=inbox.myapp.com
DOCUMENTS_EMAIL_POLLING_ENABLED=false
DOCUMENTS_EMAIL_POLL_INTERVAL_MS=60000

# Gemini AI processing
GEMINI_API_KEY=your_gemini_api_key
DOCUMENTS_GEMINI_MODEL=gemini-3-flash-preview
DOCUMENTS_GEMINI_MODEL_BASIC=gemini-3-flash-preview
DOCUMENTS_GEMINI_MODEL_ADVANCED=gemini-3-flash-preview
DOCUMENTS_GEMINI_MAX_INLINE_BYTES=8388608
DOCUMENTS_DISABLE_GEMINI=false
DOCUMENTS_SCAN_CRON_ENABLED=true
DOCUMENTS_SCAN_CRON_INTERVAL_MS=45000
DOCUMENTS_SCAN_STALE_MINUTES=10
DOCUMENTS_FOLDER_OPEN_ACCESS=true

# Optional: API rate limiting (default: 200 in production, 1000 in development)
# RATE_LIMIT_MAX=1000

# Optional queue acceleration (if omitted, processing runs inline)
# REDIS_URL=redis://localhost:6379
