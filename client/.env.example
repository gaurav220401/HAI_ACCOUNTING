# ============================================================================
#  FRONTEND ENVIRONMENT  —  Vercel project: hai-accounting
# ============================================================================
#  Local use:   cp .env.example .env.local    then fill in the values
#  Vercel use:  Project → Settings → Environment Variables → paste key/value
#
#  All of these are NEXT_PUBLIC_*, which means they are inlined into the
#  JavaScript bundle AT BUILD TIME. Changing one in Vercel requires a REDEPLOY,
#  not just a restart.
#
#  These are not secrets. Firebase web config is public by design and ships in
#  the bundle either way — security comes from Firebase Auth rules, not from
#  hiding these values.
# ============================================================================


# ── API LOCATION ────────────────────────────────────────────────────────────
# MUST include the /api suffix — the client appends paths directly to it,
# e.g. `${NEXT_PUBLIC_API_URL}/items`. Without it every request 404s.
#
# Production: https://api-hai-accounting.vercel.app/api
# Local:      http://localhost:5000/api
NEXT_PUBLIC_API_URL=


# ── FIREBASE WEB SDK ────────────────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → SDK setup and
# configuration. Copy each field from the config object shown there.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
